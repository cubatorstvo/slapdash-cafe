[sub_resource type="Shader" id="Shader_skin"]
code = "shader_type spatial;\nuniform vec4 base_color : source_color = vec4(0.803922, 0.533333, 0.411765, 1.0);\nuniform float bend_phase = 0.0;\nuniform float bend_amplitude = 0.018;\nvoid vertex() {\n\tfloat along = clamp((VERTEX.y + 0.32) / 0.64, 0.0, 1.0);\n\tVERTEX.x -= sin(bend_phase + along * 5.0) * bend_amplitude;\n\tVERTEX.z += cos(bend_phase * 0.7 + along * 5.0) * bend_amplitude;\n}\nvoid fragment() {\n\tALBEDO = base_color.rgb;\n\tROUGHNESS = 0.68;\n}"

